{
  "name": "dead-souls-launcher",
  "version": "0.3.6",
  "private": true,
  "description": "Dead Souls Launcher для DayZ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis --publish never",
    "pack": "electron-builder --win dir --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "productName": "Dead Souls Launcher",
  "build": {
    "appId": "online.dzdeadsouls.launcher",
    "productName": "Dead Souls Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "DeadSoulsLauncher-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "MrGragory",
      "repo": "dead-souls-launcher"
    },
    "asar": false
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
